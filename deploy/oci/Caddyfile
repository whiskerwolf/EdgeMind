# EdgeMind Production Caddyfile
# Handles automatic TLS termination, production React SPA serving with fallback,
# reverse proxy to FastAPI backend (/api/*, /health), security headers, and compression.

{
    # Global options
    admin off
    auto_https disable_redirects # Allow Caddy to serve both HTTP and HTTPS if configured, or auto HTTPS
    servers {
        trusted_proxies static private_ranges
    }
}

# Production Endpoint Definition
# If DOMAIN_NAME is set (e.g. edgemind.example.com), Caddy provisions Let's Encrypt TLS automatically.
# Otherwise, it falls back to serving HTTPS with an internal self-signed certificate on port 443 and HTTP on 80.
{$DOMAIN_NAME::80, :443} {
    # Request body size limit (prevents DoS via payload bloating)
    request_body {
        max_size 10MB
    }

    # Compression for text, JSON, static bundles, and streaming responses
    encode zstd gzip

    # Production Security Response Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # 1. Backend Health Endpoint
    handle /health {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 2. Backend REST & SSE Streaming API Endpoints
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Disable response buffering so SSE tokens stream immediately
            flush_interval -1

            # Health check configuration for upstream backend
            health_uri /health
            health_interval 10s
            health_timeout 3s
        }
    }

    # 3. Frontend Production React SPA + Client-Side Routing Fallback
    handle {
        root * /srv/web
        @hashed_assets path /assets/*
        header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
        try_files {path} /index.html
        file_server
    }

    # Access and Error Logging
    log {
        output stdout
        format json
        level INFO
    }
}
