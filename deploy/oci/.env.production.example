# EdgeMind Production Environment Configuration Template (OCI Always Free ARM64)
# Copy this file to .env.production on the OCI VM host.
# NEVER commit the real .env.production file to version control.
# Generate strong 32-byte cryptographic hex tokens using: openssl rand -hex 32

# Application Settings
APP_NAME="EdgeMind API"
APP_VERSION=1.0.0
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEBUG=false
STATIC_ONLY=true

# Domain & TLS Configuration for Caddy Reverse Proxy
# Set DOMAIN_NAME to your FQDN (e.g. edgemind.example.com) for automatic Let's Encrypt TLS.
# Leave blank to fallback to self-signed TLS on the instance public IP.
DOMAIN_NAME=

# Database Credentials (PostgreSQL 16 + pgvector)
POSTGRES_USER=edgemind_admin
POSTGRES_PASSWORD=replace_with_strong_random_db_password_64hex
POSTGRES_DB=edgemind
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Redis Cache Security (Port 6379 internal)
REDIS_PASSWORD=replace_with_strong_random_redis_password_64hex
REDIS_POOL_SIZE=15
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_KEY_PREFIX=edgemind:cache:v1

# Redis Rate Limiter Security (Port 6379 internal, dedicated instance)
REDIS_RATE_LIMIT_PASSWORD=replace_with_strong_random_rate_limit_password_64hex
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FALLBACK_ALLOW=false
RATE_LIMIT_DEFAULT_LIMIT=60
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_AGENT_LIMIT=10
RATE_LIMIT_AGENT_WINDOW=60
TRUSTED_PROXY_IPS='["127.0.0.1", "caddy"]'

# Production Ollama AI Configuration (CPU Inference on ARM64)
EDGEMIND_AGENT_PROVIDER=ollama
AGENT_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=120.0
RAG_EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=all-minilm:latest
OLLAMA_EMBEDDING_DIMENSIONS=384

# Authentication & Security Keys
JWT_SECRET_KEY=replace_with_strong_random_jwt_secret_64hex
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=edgemind-api
JWT_AUDIENCE=edgemind-client

# Administrator Bootstrap Credentials (Optional)
ADMIN_BOOTSTRAP_EMAIL=admin@edgemind.internal
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_random_admin_password_32hex

# CORS Policy & Chrome Extension Isolation
# Restrict to your frontend domain and exact 32-character Chrome extension ID
CORS_ORIGINS='["https://edgemind.example.com"]'
EDGEMIND_CHROME_EXTENSION_ID=
