# EdgeMind Scheduled Backup & Database Maintenance Environment Overrides
# Copied to /etc/edgemind/maintenance.env by install-systemd-timers.sh (0600 permissions).
# Never place secrets in logs; database credentials remain in .env.production.

# Persistent host backup storage path
BACKUP_DIR=/opt/edgemind/backups

# Retain daily PostgreSQL backups for N days before automatic pruning
RETENTION_DAYS=7

# Days after refresh token expiration before automated cleanup deletes the row
TOKEN_CLEANUP_GRACE_DAYS=1

# Days revoked refresh tokens are retained before pruning (preserves token reuse detection)
TOKEN_CLEANUP_REVOKED_GRACE_DAYS=7
