[Unit]
Description=EdgeMind Scheduled Database Maintenance Job
Documentation=https://github.com/whiskerwolf/EdgeMind/blob/main/deploy/oci/README.md
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/edgemind/deploy/oci
EnvironmentFile=-/etc/edgemind/maintenance.env
ExecStart=/opt/edgemind/deploy/oci/scripts/run-db-maintenance.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edgemind-maintenance
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=600
