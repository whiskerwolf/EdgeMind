# ==============================================================================
# EdgeMind Environment Configuration Template
# Copy this file to .env to configure local settings. Never commit actual .env.
# ==============================================================================

# Application Metadata
APP_NAME="EdgeMind API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Server Bindings
HOST="127.0.0.1"
PORT=8000
DEBUG=false

# Static-Only Safety Invariants (Permanent Safety Rule)
STATIC_ONLY=true
MAX_SOURCE_SIZE=65536
DEFAULT_FILENAME="snippet.py"

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]'
CORS_ORIGIN_REGEX="^chrome-extension://[a-p]{32}$"
CORS_ALLOW_CREDENTIALS=true

# Request Tracing Headers
REQUEST_ID_HEADER="X-Request-ID"
PROCESS_TIME_HEADER="X-Process-Time"

# Local Ollama AI Provider & RAG Configuration (Phase 5 & 6)
# When running on host: http://127.0.0.1:11434
# When running in Docker: http://host.docker.internal:11434
EDGEMIND_AGENT_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b"
OLLAMA_TIMEOUT=60.0
RAG_EMBEDDING_PROVIDER="ollama"
OLLAMA_EMBEDDING_MODEL="all-minilm:latest"
OLLAMA_EMBEDDING_DIMENSIONS=384

# External AI Reasoning Providers (Optional)
# If left blank, EdgeMind safely operates using its deterministic AST intelligence engine.
EDGEMIND_AI_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Database Configuration (PostgreSQL / SQLAlchemy 2.0 Async)
# Host development via Docker Compose: host port 5433 mapped to container 5432:
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_postgres_password_here"
POSTGRES_DB="edgemind"
POSTGRES_PORT=5433
# Host URL:
# DATABASE_URL="postgresql+asyncpg://postgres:your_secure_postgres_password_here@localhost:5433/edgemind"
# In-container URL:
# DATABASE_URL="postgresql+asyncpg://postgres:your_secure_postgres_password_here@postgres:5432/edgemind"
# In-memory / local SQLite fallback for isolated unit tests:
# DATABASE_URL="sqlite+aiosqlite:///./edgemind.db"
DATABASE_URL=""
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# JWT Authentication & Multi-Tenancy (Phase 3)
# Cryptographic secret key for signing access and refresh tokens. Must be strong in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="edgemind-api"
JWT_AUDIENCE="edgemind-client"

# Administrator Bootstrap (Phase 3)
# If provided, an administrator account is safely initialized on startup if no admin exists.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Redis & Distributed Caching (Phase 4)
# Redis connection URL for connection pooling, RAG caching, and distributed rate limiting.
# REDIS_PASSWORD must be explicitly configured in production; never commit credentials.
REDIS_PASSWORD="your_secure_redis_password_here"
REDIS_PORT=6379
REDIS_IMAGE="redis:7.2.17-alpine3.21"
# Host URL: redis://:your_secure_redis_password_here@localhost:6379/0
# Container URL: redis://:your_secure_redis_password_here@redis:6379/0
REDIS_URL=""
REDIS_POOL_SIZE=20
REDIS_CONNECT_TIMEOUT=3.0
REDIS_SOCKET_TIMEOUT=3.0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_KEY_PREFIX="edgemind:cache:v1"

# Dedicated Rate Limiting Redis (Phase 4 - Memory Isolation)
# When set, rate limiting uses this dedicated instance instead of the caching Redis.
REDIS_RATE_LIMIT_PORT=6380
# Host URL: redis://:your_secure_redis_password_here@localhost:6380/0
# Container URL: redis://:your_secure_redis_password_here@redis-rate-limit:6379/0
REDIS_RATE_LIMIT_URL=""
REDIS_RATE_LIMIT_PASSWORD=""

# Distributed Rate Limiting (Phase 4)
RATE_LIMIT_ENABLED=true
# Fallback policy when Redis is unavailable: false = fail-closed (production default), true = fail-open (dev/testing)
RATE_LIMIT_FALLBACK_ALLOW=false
RATE_LIMIT_DEFAULT_LIMIT=60
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_AGENT_LIMIT=10
RATE_LIMIT_AGENT_WINDOW=60
TRUSTED_PROXY_IPS='["127.0.0.1", "::1"]'
