# ==============================================================================
# EdgeMind Environment Configuration Template
# Copy this file to .env to configure local settings.
# ==============================================================================

# Application Metadata
APP_NAME="EdgeMind API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# Server Bindings
HOST="127.0.0.1"
PORT=8000
DEBUG=false

# Static-Only Safety Invariants (Permanent Safety Rule)
STATIC_ONLY=true
MAX_SOURCE_SIZE=65536
DEFAULT_FILENAME="snippet.py"

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]'
CORS_ORIGIN_REGEX="^chrome-extension://[a-p]{32}$"
CORS_ALLOW_CREDENTIALS=true

# Request Tracing Headers
REQUEST_ID_HEADER="X-Request-ID"
PROCESS_TIME_HEADER="X-Process-Time"

# External AI Reasoning Providers (Optional)
# If left blank, EdgeMind safely operates using its deterministic AST intelligence engine.
EDGEMIND_AI_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Database Configuration (PostgreSQL / SQLAlchemy 2.0 Async)
# Local development default with Docker Compose:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/edgemind"
# In-memory / local SQLite fallback for isolated unit tests:
# DATABASE_URL="sqlite+aiosqlite:///./edgemind.db"
DATABASE_URL=""
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false


